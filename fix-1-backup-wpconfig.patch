+    /**
+     * Path del backup di wp-config.php dentro private/.
+     */
+    public static function backup_path() {
+        return DBDM_Emergency::private_dir() . 'wp-config.dbdm-bak';
+    }
+
+    /**
+     * Elimina il backup legacy creato accanto a wp-config.php dalle
