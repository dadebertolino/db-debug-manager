{
    "name": "dadebertolino/db-debug-manager",
    "description": "Gestione centralizzata del debug di WordPress: costanti in wp-config.php, viewer del debug.log, monitor query, snapshot, accesso d'emergenza standalone.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Davide Bertolino",
            "homepage": "https://davidebertolino.it"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 -P4 php -l",
        "phpcs": "phpcs",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
